{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/opt/mellanox/**"
            ],
            "defines": [
                "__dpa_global__=",
                "__dpa_device__=",
                "__dpa_shared__=",
                "__dpa_rpc__=",
                "__DPA_MEMORY=0",
                "__DPA_W=0",
                "__DPA_R=0",
                "__DPA_RW=0",
                "CLOCK_MONOTONIC=1",
                "FLEXIO_DEV_ALWAYS_INLINE="
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-arm64"
        }
    ],
    "version": 4
}